# Symbolication related
app.*.symbols

# Obfuscation related
app.*.map.json

# Android Studio will place build artifacts here
/android/app/debug
/android/app/profile
/android/app/release
.venv/

# Backend (Django) -- the dev database is a build artifact, not source. It is
# rebuilt by `manage.py migrate` plus the seed_* commands (see backend/README.md),
# so tracking it only produces unreviewable binary diffs in unrelated commits
# and conflicts for anyone running migrations.
*.sqlite3
*.sqlite3-journal
# WAL sidecars (journal_mode=WAL, see medalert_api/settings.py)
*.sqlite3-wal
*.sqlite3-shm
docs