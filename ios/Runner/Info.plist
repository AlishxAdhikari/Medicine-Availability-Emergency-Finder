<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
	<key>CADisableMinimumFrameDurationOnPhone</key>
	<true/>
	<key>CFBundleDevelopmentRegion</key>
	<string>$(DEVELOPMENT_LANGUAGE)</string>
	<key>CFBundleDisplayName</key>
	<string>Medalert</string>
	<key>CFBundleExecutable</key>
	<string>$(EXECUTABLE_NAME)</string>
	<key>CFBundleIdentifier</key>
	<string>$(PRODUCT_BUNDLE_IDENTIFIER)</string>
	<key>CFBundleInfoDictionaryVersion</key>
	<string>6.0</string>
	<key>CFBundleName</key>
	<string>medalert</string>
	<key>CFBundlePackageType</key>
	<string>APPL</string>
	<key>CFBundleShortVersionString</key>
	<string>$(FLUTTER_BUILD_NAME)</string>
	<key>CFBundleSignature</key>
	<string>????</string>
	<key>CFBundleVersion</key>
	<string>$(FLUTTER_BUILD_NUMBER)</string>
	<key>LSRequiresIPhoneOS</key>
	<true/>
	<!-- Allows plain HTTP to the local Django dev server. Remove this once the
	     backend is deployed behind HTTPS.

	     NSAllowsLocalNetworking is the one that matters on a physical device:
	     the localhost/127.0.0.1 exceptions below only cover the phone talking
	     to itself, which is never what we want on hardware. A real iPhone
	     reaches the dev server at a LAN address like 192.168.1.64:8000, and
	     without this key iOS blocks every http:// and ws:// request to it,
	     silently, and identically to the server being down.

	     Preferred over NSAllowsArbitraryLoads because it permits exactly the
	     local-network traffic we need and still blocks cleartext to the
	     public internet. -->
	<key>NSAppTransportSecurity</key>
	<dict>
		<key>NSAllowsLocalNetworking</key>
		<true/>
		<key>NSExceptionDomains</key>
		<dict>
			<key>localhost</key>
			<dict>
				<key>NSExceptionAllowsInsecureHTTPLoads</key>
				<true/>
			</dict>
			<key>127.0.0.1</key>
			<dict>
				<key>NSExceptionAllowsInsecureHTTPLoads</key>
				<true/>
			</dict>
		</dict>
	</dict>
	<!-- iOS 14+ prompts before an app may talk to devices on the local
	     network, and this string is what the prompt shows. Without the key the
	     request is denied outright; if the user taps "Don't Allow", every
	     backend call fails in a way indistinguishable from a dead server. -->
	<key>NSLocalNetworkUsageDescription</key>
	<string>MedAlert connects to the MedAlert server running on your local network to look up pharmacies, medicine stock and emergency services.</string>
	<!-- url_launcher checks canLaunchUrl against this allowlist before opening
	     anything. Without it, Call and Directions silently report "no app
	     available" on iOS. comgooglemaps is listed so Google Maps is offered
	     when installed; the https: fallback covers the case where it isn't. -->
	<key>LSApplicationQueriesSchemes</key>
	<array>
		<string>tel</string>
		<string>maps</string>
		<string>comgooglemaps</string>
		<string>https</string>
	</array>
	<!-- Location is only read while the user is looking at a search screen;
	     there is no background tracking, so When-In-Use is the whole ask. -->
	<key>NSLocationWhenInUseUsageDescription</key>
	<string>MedAlert uses your location to find the nearest pharmacies, blood banks and ambulance services, and to sort them by how far away they are.</string>
	<!-- image_picker's two sources, used by the AI prescription scanner. iOS
	     terminates the app outright when a usage description is missing for a
	     permission it requests, so without these the scanner does not degrade
	     gracefully. It crashes on first use. -->
	<key>NSCameraUsageDescription</key>
	<string>MedAlert uses your camera to photograph a prescription so it can read the medicine names and search for them nearby.</string>
	<key>NSPhotoLibraryUsageDescription</key>
	<string>MedAlert needs access to your photos so you can choose an existing prescription photo to scan.</string>
	<key>UIApplicationSceneManifest</key>
	<dict>
		<key>UIApplicationSupportsMultipleScenes</key>
		<false/>
		<key>UISceneConfigurations</key>
		<dict>
			<key>UIWindowSceneSessionRoleApplication</key>
			<array>
				<dict>
					<key>UISceneClassName</key>
					<string>UIWindowScene</string>
					<key>UISceneConfigurationName</key>
					<string>flutter</string>
					<key>UISceneDelegateClassName</key>
					<string>$(PRODUCT_MODULE_NAME).SceneDelegate</string>
					<key>UISceneStoryboardFile</key>
					<string>Main</string>
				</dict>
			</array>
		</dict>
	</dict>
	<key>NSFaceIDUsageDescription</key>
	<string>MedAlert uses Face ID / Touch ID to let you sign back in quickly without retyping your password.</string>
	<key>UIApplicationSupportsIndirectInputEvents</key>
	<true/>
	<key>UILaunchStoryboardName</key>
	<string>LaunchScreen</string>
	<key>UIMainStoryboardFile</key>
	<string>Main</string>
	<key>UISupportedInterfaceOrientations</key>
	<array>
		<string>UIInterfaceOrientationPortrait</string>
		<string>UIInterfaceOrientationLandscapeLeft</string>
		<string>UIInterfaceOrientationLandscapeRight</string>
	</array>
	<key>UISupportedInterfaceOrientations~ipad</key>
	<array>
		<string>UIInterfaceOrientationPortrait</string>
		<string>UIInterfaceOrientationPortraitUpsideDown</string>
		<string>UIInterfaceOrientationLandscapeLeft</string>
		<string>UIInterfaceOrientationLandscapeRight</string>
	</array>
</dict>
</plist>
