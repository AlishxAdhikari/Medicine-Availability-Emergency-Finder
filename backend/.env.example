# Copy this file to .env and fill in real values.
# .env is already git-ignored — never commit real credentials.

# Django
SECRET_KEY=your_secure_key_here
DEBUG=True

# Comma-separated hostnames Django will answer to. MUST include the address
# phones type into the app -- a device hitting http://192.168.1.64:8000 sends
# "Host: 192.168.1.64:8000", and any host missing from this list is rejected
# with 400 DisallowedHost, which from the app looks like the server is down.
# Find your LAN IP with `ipconfig` (Windows) or `ifconfig`/`ip addr` (macOS,
# Linux), and start the server with: python manage.py runserver 0.0.0.0:8000
ALLOWED_HOSTS=127.0.0.1,localhost,10.0.2.2,0.0.0.0,192.168.1.64

# Only read when DEBUG=False. Comma-separated list of allowed frontend origins.
CORS_ALLOWED_ORIGINS=

# PostgreSQL
DATABASE_NAME=medalert_api
DATABASE_USER=postgres
DATABASE_PASSWORD=password # ← put the real password here
DATABASE_HOST=localhost
DATABASE_PORT=5432
