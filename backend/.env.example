# Copy this file to .env and fill in real values.
# .env is already git-ignored — never commit real credentials.

# Django
# Required whenever DEBUG=False -- the server refuses to start without it.
# Generate one with:
#   python -c "from django.core.management.utils import get_random_secret_key; print(get_random_secret_key())"
SECRET_KEY=your_secure_key_here

# False unless set. Keep it True for local development; never True on a
# server you can reach from outside your machine.
DEBUG=True

# Comma-separated hostnames Django will answer to. MUST include the address
# phones type into the app -- a device hitting http://192.168.1.64:8000 sends
# "Host: 192.168.1.64:8000", and any host missing from this list is rejected
# with 400 DisallowedHost, which from the app looks like the server is down.
# Find your LAN IP with `ipconfig` (Windows) or `ifconfig`/`ip addr` (macOS,
# Linux), and start the server with: python manage.py runserver 0.0.0.0:8000
ALLOWED_HOSTS=127.0.0.1,localhost,10.0.2.2,0.0.0.0,192.168.1.64

# Only read when DEBUG=False. Comma-separated list of allowed frontend origins.
CORS_ALLOWED_ORIGINS=

# Comma-separated origins (with scheme) trusted for CSRF, e.g. the domain the
# Django admin is served from: https://medalert.example.com
CSRF_TRUSTED_ORIGINS=

# Turn on only once the deployment terminates TLS: forces https, enables HSTS.
# Left off by default because it would redirect the test suite to https.
HTTPS_ONLY=False

# PostgreSQL
DATABASE_NAME=medalert_api
DATABASE_USER=postgres
DATABASE_PASSWORD=password # ← put the real password here
DATABASE_HOST=localhost
DATABASE_PORT=5432
