# Copy this file to .env and fill in real values.
# .env is already git-ignored — never commit real credentials.

# Django
SECRET_KEY=your_secure_key_here
DEBUG=True

# Only read when DEBUG=False. Comma-separated list of allowed frontend origins.
CORS_ALLOWED_ORIGINS=

# PostgreSQL
DATABASE_NAME=medalert_api
DATABASE_USER=postgres
DATABASE_PASSWORD=your_actual_postgres_password   # ← put the real password here
DATABASE_HOST=localhost
DATABASE_PORT=5432
